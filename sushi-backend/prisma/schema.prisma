generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
}

model Category {
  id     Int    @id @default(autoincrement())
  name   String @unique
  nameEn String?
  slug   String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            Int     @id @default(autoincrement())
  name          String
  nameEn        String?
  description   String
  descriptionEn String?
  price         Int
  weight        String
  imageUrl      String
  isAvailable   Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  favorites  Favorite[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id Int @id @default(autoincrement())

  firstName String?
  lastName  String?
  gender    Gender?
  birthDate DateTime?
  // Only a verified Google identity may set the sign-in email.
  email        String? @unique
  contactEmail String?
  phone        String?

  telegramId String? @unique
  googleId   String? @unique

  favorites Favorite[]
  orders    Order[]
  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TelegramAuthSession {
  id Int @id @default(autoincrement())

  token      String @unique
  telegramId String?
  code       String?

  expiresAt DateTime
  verified  Boolean @default(false)
  failedAttempts Int @default(0)

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RequestRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Favorite {
  id Int @id @default(autoincrement())

  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id Int @id @default(autoincrement())

  userId Int

  city   String
  street String
  house  String

  apartment String?
  entrance  String?
  floor     String?
  comment   String?

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  guestToken String? @unique

  idempotencyKey String? @unique
  requestHash    String?
  recipientPhone String?

  status OrderStatus @default(PENDING)

  subtotal    Int @default(0)
  deliveryFee Int @default(0)
  totalPrice  Int

  deliveryType  DeliveryType
  paymentMethod PaymentMethod @default(CARD_ON_DELIVERY)

  address String?
  comment String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId   Int
  productId Int

  quantity    Int
  productName String
  unitPrice   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
